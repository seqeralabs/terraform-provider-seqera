{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "branchPrefix": "renovate/",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.speakeasy/workflow\\.yaml$/"],
      "matchStrings": ["speakeasyVersion: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "speakeasy-api/speakeasy",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["speakeasy-api/speakeasy"],
      "additionalBranchPrefix": "speakeasy-update-",
      "branchTopic": "v{{{newValue}}}",
      "rebaseWhen": "conflicted",
      "commitMessagePrefix": "chore:"
    }
  ]
}
